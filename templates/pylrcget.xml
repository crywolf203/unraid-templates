<?xml version="1.0"?>
<Container version="2">
  <Name>PyLrcGet</Name>
  <Repository>crywolf203/pylrcget-unraid:latest</Repository>
  <Registry>https://hub.docker.com/r/crywolf203/pylrcget-unraid</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/crywolf203/pylrcget-unraid/issues</Support>
  <Project>https://github.com/saitatter/pylrcget</Project>
  <Overview>Unofficial Unraid-friendly Docker container for PyLrcGet, packaged inside LinuxServer Webtop for browser-based desktop access. Includes PyLrcGet, Firefox, Google Chrome, ffmpeg, mediainfo, kid3-cli, and desktop launchers. Use HTTPS for the WebUI.</Overview>
  <Category>MediaApp:Music Tools:</Category>
  <WebUI>https://[IP]:[PORT:3001]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/crywolf203/unraid-templates/main/templates/pylrcget.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/crywolf203/pylrcget-unraid/main/icon.png</Icon>
  <ExtraParams>--shm-size="1gb"</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText>Buy Me a Coffee</DonateText>
  <DonateLink>https://buymeacoffee.com/crywolf203</DonateLink>
  <Requires/>
  <Config Name="WebUI HTTPS Port" Target="3001" Default="5801" Mode="tcp" Description="HTTPS Webtop browser access port. Open https://[IP]:[PORT:3001]/" Type="Port" Display="always" Required="true" Mask="false">5801</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/pylrcget" Mode="rw" Description="Container config, Webtop profile, browser data, and app settings." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pylrcget</Config>
  <Config Name="Music" Target="/music" Default="/mnt/user/media/music" Mode="rw" Description="Music library path. Use /music inside PyLrcGet. Change this to your actual Unraid music path." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media/music</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID. Unraid default is 99." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID. Unraid default is 100." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="Timezone" Target="TZ" Default="America/New_York" Mode="" Description="Container timezone." Type="Variable" Display="always" Required="true" Mask="false">America/New_York</Config>
  <Config Name="GUI Autostart" Target="GUIAUTOSTART" Default="true" Mode="" Description="Enable Webtop GUI autostart." Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
</Container>
