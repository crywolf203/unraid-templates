<?xml version="1.0"?>
<Container version="2">
  <Name>LRCGET</Name>
  <Repository>ghcr.io/crywolf203/lrcget-unraid:latest</Repository>
  <Registry>https://github.com/crywolf203/lrcget-unraid/pkgs/container/lrcget-unraid</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/crywolf203/lrcget-unraid/issues</Support>
  <Project>https://github.com/tranxuanthang/lrcget</Project>
  <Overview>
LRCGET is a utility for mass-downloading synced LRC lyrics for your offline music library. This Unraid container runs the Linux desktop app inside a browser-accessible GUI container on port 5800.

This is an unofficial Unraid container/template for LRCGET.
  </Overview>
  <Category>MediaApp:Music</Category>
  <WebUI>http://[IP]:[PORT:5800]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/crywolf203/unraid-templates/main/templates/lrcget.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/tranxuanthang/lrcget/main/src-tauri/icons/128x128.png</Icon>
  <ExtraParams>--shm-size=8g --cap-add=SYS_NICE --tmpfs /tmp:rw,size=8g</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="5800" Default="5800" Mode="tcp" Description="Browser GUI port for LRCGET." Type="Port" Display="always" Required="true" Mask="false">5800</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/lrcget" Mode="rw" Description="Persistent LRCGET config and database." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/lrcget</Config>
  <Config Name="Music" Target="/music" Default="/mnt/user/media/music" Mode="rw" Description="Music library folder. Change this to your actual Unraid music path." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media/music</Config>
  <Config Name="USER_ID" Target="USER_ID" Default="99" Mode="" Description="Container user ID. 99 is the default Unraid nobody user." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="GROUP_ID" Target="GROUP_ID" Default="100" Mode="" Description="Container group ID. 100 is the default Unraid users group." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="UMASK" Target="UMASK" Default="000" Mode="" Description="File permission mask." Type="Variable" Display="advanced" Required="true" Mask="false">000</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="Timezone." Type="Variable" Display="advanced" Required="true" Mask="false">America/New_York</Config>
  <Config Name="KEEP_APP_RUNNING" Target="KEEP_APP_RUNNING" Default="1" Mode="" Description="Keep the GUI app running." Type="Variable" Display="advanced" Required="true" Mask="false">1</Config>
  <Config Name="DISPLAY_WIDTH" Target="DISPLAY_WIDTH" Default="1920" Mode="" Description="Browser GUI display width." Type="Variable" Display="advanced" Required="false" Mask="false">1920</Config>
  <Config Name="DISPLAY_HEIGHT" Target="DISPLAY_HEIGHT" Default="1080" Mode="" Description="Browser GUI display height." Type="Variable" Display="advanced" Required="false" Mask="false">1080</Config>
  <Config Name="ENABLE_CJK_FONT" Target="ENABLE_CJK_FONT" Default="1" Mode="" Description="Enable CJK fonts." Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="APP_NICENESS" Target="APP_NICENESS" Default="-10" Mode="" Description="Process niceness. Negative values require SYS_NICE capability, which is included in Extra Parameters." Type="Variable" Display="advanced" Required="false" Mask="false">-10</Config>
  <Config Name="GDK_BACKEND" Target="GDK_BACKEND" Default="x11" Mode="" Description="GTK backend. Required for the browser GUI container." Type="Variable" Display="advanced" Required="false" Mask="false">x11</Config>
  <Config Name="LIBGL_ALWAYS_SOFTWARE" Target="LIBGL_ALWAYS_SOFTWARE" Default="1" Mode="" Description="Use software rendering to avoid black screen issues." Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="WEBKIT_DISABLE_DMABUF_RENDERER" Target="WEBKIT_DISABLE_DMABUF_RENDERER" Default="1" Mode="" Description="Disable WebKit DMABUF renderer to avoid black screen issues." Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="WEBKIT_DISABLE_COMPOSITING_MODE" Target="WEBKIT_DISABLE_COMPOSITING_MODE" Default="1" Mode="" Description="Disable WebKit compositing mode to avoid black screen issues." Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
  <Config Name="NO_AT_BRIDGE" Target="NO_AT_BRIDGE" Default="1" Mode="" Description="Disable accessibility bridge warnings." Type="Variable" Display="advanced" Required="false" Mask="false">1</Config>
</Container>
